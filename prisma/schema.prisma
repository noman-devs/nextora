generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  name      String?
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Lead {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String
  phone     String?
  company   String?
  service   String?
  message   String?
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads")
}

model BlogPost {
  id            String    @id @default(cuid()) @map("_id")
  title         String
  slug          String    @unique
  excerpt       String?
  content       String    @default("")
  seoTitle      String?
  metaDesc      String?
  featuredImage String?
  category      String?
  status        String    @default("draft")
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("blog_posts")
}

model PortfolioProject {
  id            String   @id @default(cuid()) @map("_id")
  title         String
  slug          String   @unique
  description   String?
  content       String?
  category      String?
  projectUrl    String?
  featuredImage String?
  images        String   @default("[]")
  results       String   @default("[]")
  tags          String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("portfolio_projects")
}

model Testimonial {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  company   String?
  role      String?
  content   String
  image     String?
  rating    Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model ServiceItem {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  description String?
  icon        String   @default("Globe")
  features    String   @default("[]")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model Subscriber {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model Media {
  id        String   @id @default(cuid()) @map("_id")
  filename  String
  url       String
  type      String   @default("image")
  size      Int      @default(0)
  createdAt DateTime @default(now())

  @@map("media")
}

model Setting {
  id   String @id @default("global") @map("_id")
  data String @default("{}")

  @@map("settings")
}
