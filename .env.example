# MongoDB Database - Get from MongoDB Atlas
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/nextora?retryWrites=true&w=majority"

# NextAuth Configuration
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="https://your-domain.com"

# Admin Credentials (used for initial seed)
ADMIN_EMAIL="admin@nextora.com"
ADMIN_PASSWORD="your-admin-password"
